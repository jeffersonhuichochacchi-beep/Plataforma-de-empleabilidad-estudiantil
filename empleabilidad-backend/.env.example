# Server Configuration
SERVER_PORT=8081

# Database Configuration (Supabase PostgreSQL)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?currentSchema=public
SUPABASE_DB_USER=postgres.your-project
SUPABASE_DB_PASSWORD=your-database-password

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1

# Storage Configuration
STORAGE_LOCAL_BASE_PATH=/tmp
STORAGE_CV_MAX_SIZE_MB=5

# APIs Peru
APISPERU_TOKEN=your-token
APISPERU_USERNAME=your-username
APISPERU_PASSWORD=your-password
APISPERU_AUTH_URL=https://facturacion.apisperu.com/api/v1/auth/login
APISPERU_DNI_URL=https://dniruc.apisperu.com/api/v1/dni
APISPERU_RUC_URL=https://dniruc.apisperu.com/api/v1/ruc

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-exp

# CORS Configuration (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# JPA Configuration
JPA_SHOW_SQL=false
